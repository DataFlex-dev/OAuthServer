Use cWebComponent.pkg
Use cCharTranslate.pkg
Use Oidc\OidcFunctions.pkg
Use Oidc\Structs\tOidcJWK.pkg
Use Oidc\Structs\tOidcJWKS.pkg
Use Oidc\Structs\tOidcKeyPair.pkg

Use Oidc\Constants\OidcOpenSSLConstants.pkg
Use Oidc\OidcOpenSSL.pkg

Class cOidcKeyStore is a cWebComponent
    Procedure Construct_Object
        Property String psCertificatesPath "Certificates"
        Property tOidcKeyPair[] atKeyPairs
        Property String psActiveKeyIdentifier ""
        
        // Create property for saving the JWKs
        Property tOidcJWKS ptJwks
        
        Object oOidcCharTranslate is a cCharTranslate
        End_Object
    End_Procedure
    
    Procedure AddKeyPair String sKid String sPublicFile String sPrivateFile
        tOidcKeyPair tSearch
        tOidcKeyPair[] atPairs
        Integer iIndex
        
        Move sKid to tSearch.sKid
        Move sPublicFile to tSearch.sPublic
        Move sPrivateFile to tSearch.sPrivate
        
        Get atKeyPairs to atPairs
        
        Move (BinarySearchArray(tSearch, atPairs)) to iIndex
        If (iIndex = -1) Begin // Not found = insert
            Move (BinarySearchInsertPos()) to iIndex
            Move (InsertInArray(atPairs, iIndex, tSearch)) to atPairs
        End
        Else Begin
            Error DFERR_PROGRAM (SFormat("KeyID (kid) '%1' already registered", sKid))
            Procedure_Return
        End
        
        Set atKeyPairs to atPairs
    End_Procedure
    
    { Visibility=Private }
    Function ResolveCertificatesPath String sFile Returns String
        Handle hoWorkspace
        String sBase sPath
        
        Get phoWorkspace of ghoApplication to hoWorkspace
        Get psHome of hoWorkspace to sBase
        Send OidcEnsureTrailingBackslash (&sBase) // The project folder "C:/DataFlex Projects/MyProject" for example
        
        Get psCertificatesPath to sPath
        Send OidcEnsureTrailingBackslash (&sPath)
        
        // Add all components together to get the right path
        Move (sBase + sPath + sFile) to sFile
        
        Function_Return sFile
    End_Function
    
    { Visibility=Private }
    Procedure LoadCertificates
        tOidcKeyPair[] atPairs
        Integer iSize iIndex
        
        Get atKeyPairs to atPairs
        Move (SizeOfArray(atPairs)) to iSize
        
        If (iSize = 0) Begin
            Error DFERR_PROGRAM "No public and/or private keys defined, please be sure to have at least one."
            Procedure_Return
        End
        
        For iIndex from 0 to (iSize - 1)
            Send LoadKeyPair atPairs[iIndex]
        Loop 
    End_Procedure
    
    { Visibility=Private }
    // TODO: Add support for password protected key files
    Procedure LoadKeyPair tOidcKeyPair tPair
        String sPubFile sPrivFile sReadMode sInputType 
        String sPubPem  sPrivPem  sKty sAlg sCrv sN sE
        Boolean bPubFileExists bPrivFileExists
        Pointer pBio pCtx pKey pRSA pN pE pBinN pBinE
        Integer iKeyType iRetVal iNumBytesN iNumBytesE
        tOidcJWK tJwk
        UChar[] ucaModulus ucaExponent
        
        Get ResolveCertificatesPath tPair.sPublic   to sPubFile
        Get ResolveCertificatesPath tPair.sPrivate  to sPrivFile
        
        File_Exist sPubFile bPubFileExists
        If (not(bPubFileExists)) Begin
            Error DFERR_PROGRAM (SFormat("Public key file '%1' missing for kid '%2'", sPubFile, tPair.sKid))
        End
        
        File_Exist sPrivFile bPrivFileExists
        If (not(bPrivFileExists)) Begin
            Error DFERR_PROGRAM (SFormat("Private key file '%1' missing for kid '%2'", sPrivFile, tPair.sKid))
        End
        
        // Pair incomplete = return
        If (not(bPubFileExists) or not(bPrivFileExists)) Begin
            Procedure_Return
        End
        
        // OpenSSL magic
        Move C_OIDC_OSSL_READ_MODE to sReadMode
        Move (OpenSSL_BIO_new_file(AddressOf(sPubFile), AddressOf(sReadMode))) to pBio
        If (pBio = 0) Begin
            Error DFERR_PROGRAM (SFormat("Error while opening public key %1", sPubFile))
            Procedure_Return
        End
        
        Move C_OIDC_OSSL_INPUT_TYPE_PEM to sInputType
        Move (OpenSSL_OSSL_DECODER_CTX_new_for_pkey(AddressOf(pKey),                    ;
                                                    AddressOf(sInputType),              ; // Input type OPTIONAL
                                                    0,                                  ; // input_struct OPTIONAL
                                                    0,                                  ; // Key type OPTIONAL (0 = any)
                                                    C_OSSL_KEYMGMT_SELECT_PUBLIC_KEY,   ; // Selection (1 = OSSL_KEYMGMT_SELECT_KEYPAIR, 2 = OSSL_KEYMGMT_SELECT_PUBLIC_KEY, 4 = OSSL_KEYMGMT_SELECT_PRIVATE_KEY)
                                                    0,                                  ; // libctx = NULL
                                                    0)) to pCtx                           // propquery = NULL
        If (pCtx = 0) Begin
            Move (OpenSSL_BIO_free(pBio)) to gVoid
            // ToDo: write better thing here
            Error DFERR_PROGRAM "Failed to load context."
            Procedure_Return
        End
        
        Move (OpenSSL_OSSL_DECODER_CTX_get_num_decoders(pCtx)) to iRetVal
        If (iRetVal = 0) Begin
            Move (OpenSSL_OSSL_DECODER_CTX_free(pCtx)) to gVoid
            Move (OpenSSL_BIO_free(pBio)) to gVoid
            Error DFERR_PROGRAM (SFormat("No decoders available for the certificate file '%1'", sPubFile))
            Procedure_Return
        End        
        
        // Decode to get modulus and exponent etc
        Move (OpenSSL_OSSL_DECODER_from_bio(pCtx, pBio)) to iRetVal
        Move (OpenSSL_OSSL_DECODER_CTX_free(pCtx)) to gVoid
        
        If (pKey = 0) Begin
            Move (OpenSSL_BIO_free(pBio)) to gVoid
            Error DFERR_PROGRAM (SFormat("Failed to decode public key %1", sPubFile))
            Procedure_Return
        End
        
        Move (PointerToString(OpenSSL_EVP_PKEY_get0_type_name(pKey))) to sKty
 
        // Start filling the struct
        Move tPair.sKid     to tJwk.sKid          // key id
        Move "sig"          to tJwk.sUse          // use for signing
        Move sKty           to tJwk.sKty          // key type based on iKeyType
        
        // CASE SWITCH BASED ON TYPE (Determines the algorithm to use)
        Case Begin
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_RSA)      // Compatible with 'RS256', 'RS384' and 'RS512'
                Move C_OIDC_OSSL_ALG_RS256          to sAlg
                Move (OpenSSL_EVP_PKEY_get0_RSA(pKey)) to pRSA

                If (pRSA = 0) Begin
                    Move (OpenSSL_EVP_PKEY_free(pKey)) to gVoid
                    Error DFERR_PROGRAM "EVP_PKEY is not an RSA key"
                    Procedure_Return
                End
                
                Move 0                                                              to pN
                Move 0                                                              to pE
                Move (OpenSSL_RSA_get0_key(pRSA, AddressOf(pN), AddressOf(pE), 0))  to gVoid
                
                Move (OpenSSL_BN_num_bits(pN))                                      to iNumBytesN
                Send OidcNumBitsToBytes (&iNumBytesN)
                Move (Alloc(iNumBytesN))                                            to pBinN
                
                Move (OpenSSL_BN_num_bits(pE))                                      to iNumBytesE
                Send OidcNumBitsToBytes (&iNumBytesE)
                Move (Alloc(iNumBytesE))                                            to pBinE
                
                Move (OpenSSL_BN_bn2bin(pN, pBinN))                                 to gVoid
                Move (OpenSSL_BN_bn2bin(pE, pBinE))                                 to gVoid
                
                // Get base64 url encoded modulus and exponent
                Get Base64EncodeToStr of oOidcCharTranslate pBinN iNumBytesN        to sN
                Send OidcBase64ToBase64Url (&sN)
                Get Base64EncodeToStr of oOidcCharTranslate pBinE iNumBytesE        to sE
                Send OidcBase64ToBase64Url (&sE)
                
                Move (OpenSSL_CRYPTO_free(pBinN, 0, 0))                             to gVoid
                Move (OpenSSL_CRYPTO_free(pBinE, 0, 0))                             to gVoid
                
                Move sN                                                             to tJwk.sN
                Move sE                                                             to tJwk.sE
                Case Break
            
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_RSA_PSS)  // Compatible with 'PS256', 'PS384' and 'PS512'
                Move C_OIDC_OSSL_ALG_PS256          to sAlg
                Case Break
            
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_EC)       // Compatible with 'ES256', 'ES384' and 'ES512'
                Move C_OIDC_OSSL_ALG_ES256          to sAlg
                Move C_OIDC_OSSL_ALG_ES256_CURVE    to sCrv
                Case Break
            
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_ED448)    // Compatible with 'EdDSA'
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_ED25519)
                Move C_OIDC_OSSL_ALG_EdDSA          to sAlg
                Case Break
            
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_DSA)
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_GostR3410_2001)
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_GostR3410_2012_256)
            Case (sKty = C_OIDC_OSSL_KEY_TYPE_GostR3410_2012_512)
            Case Else
                Error DFERR_PROGRAM (SFormat("Key type '%1' not supported", sKty))
        Case End
        
        // Add alg to struct
        Move sAlg to tJwk.sAlg
        
        // Get raw pem contents
        Send PKeyToPem_PKCS8 pKey False (&sPubPem)
        Move sPubPem    to tJwk.sPublicPem    // public raw key
                
        Move (OpenSSL_EVP_PKEY_free(pKey)) to gVoid
        
        // -----------------------------
        // Load PRIVATE key using PEM_read_bio_PrivateKey
        // -----------------------------
        Move 0 to pBio
        Move (OpenSSL_BIO_new_file(AddressOf(sPrivFile), AddressOf(sReadMode))) to pBio
        If (pBio = 0) Begin
            Error DFERR_PROGRAM (SFormat("Error opening private key %1", sPrivFile))
            Procedure_Return
        End
    
        Move (OpenSSL_PEM_read_bio_PrivateKey(pBio, 0, 0, 0)) to pKey
        Move (OpenSSL_BIO_free(pBio)) to gVoid
    
        If (pKey = 0) Begin
            Error DFERR_PROGRAM (SFormat("Failed to read private key %1", sPrivFile))
            Procedure_Return
        End
    
        // Convert private key to PEM
        Send PKeyToPem_PKCS8 pKey True (&sPrivPem)
        Move (OpenSSL_EVP_PKEY_free(pKey)) to gVoid
    
        Move sPrivPem to tJwk.sPrivatePem
            
        Send AddJWK tJwk
    End_Procedure
    
    Procedure PKeyToPem_PKCS8 Pointer pKey Boolean bPrivate String ByRef sPem
        Pointer pBio pBuf
        Integer iPending iRead
        String sErr
    
        // Create memory BIO
        Move (OpenSSL_BIO_new(OpenSSL_BIO_s_mem())) to pBio
    
        If (pBio = 0) Begin
            Error DFERR_PROGRAM "BIO_new failed"
            Procedure_Return
        End
    
        // Write PKCS#8 PEM (this supports all key types!)
        If (bPrivate) Begin
            // PRIVATE KEY (PKCS#8)
            Move (OpenSSL_PEM_write_bio_PrivateKey(pBio, pKey, 0, 0, 0, 0, 0)) to iRead
        End
        Else Begin
            // PUBLIC KEY (PKCS#8)
            Move (OpenSSL_PEM_write_bio_PUBKEY(pBio, pKey)) to iRead
        End
    
        If (iRead <> 1) Begin
            Move (OpenSSL_BIO_free(pBio)) to iRead
            Get GetLastOpenSSLError to sErr
            Error DFERR_PROGRAM (SFormat("PEM_write_bio_PrivateKey failed: %1", sErr))
            Procedure_Return
        End
    
        // How many bytes were written?
        Move (OpenSSL_BIO_ctrl_pending(pBio)) to iPending
    
        If (iPending <= 0) Begin
            Move (OpenSSL_BIO_free(pBio)) to iRead
            Procedure_Return
        End
    
        // Allocate buffer
        Move (Alloc(iPending + 1)) to pBuf
    
        // Read all data
        Move (OpenSSL_BIO_read(pBio, pBuf, iPending)) to iRead
    
        // Convert to string
        Move (PointerToString(pBuf)) to sPem
    
        // Clean up
        Move (OpenSSL_CRYPTO_free(pBuf, 0, 0)) to iRead
        Move (OpenSSL_BIO_free(pBio)) to iRead
    End_Procedure

    
    { Visibility=Private }
    Procedure AddJWK tOidcJWK tJWK
        tOidcJWKS tJwks
        Integer iIndex
        
        Get ptJwks to tJwks
        
        Move (BinarySearchArray(tJWK,tJwks.atKeys)) to iIndex
        If (iIndex = -1) Begin
            Move (BinarySearchInsertPos()) to iIndex
            Move (InsertInArray(tJwks.atKeys, iIndex, tJWK)) to tJwks.atKeys
        End
        
        Set ptJwks to tJwks
    End_Procedure
    
    { Visibility=Private }
    Function GetLastOpenSSLError Returns String
        UBigInt iErr
        String sBuf
        Pointer pBuf
        
        Move (OpenSSL_ERR_get_error()) to iErr
        If (iErr = 0) Function_Return ""
        
        Move (Repeat(Character(0), 256)) to sBuf
        Move (AddressOf(sBuf)) to pBuf
        
        Move (OpenSSL_ERR_error_string_n(iErr, pBuf, 256)) to iErr
        
        Function_Return (CString(sBuf))
    End_Function
    
    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        
        Send LoadCertificates
    End_Procedure

End_Class
