Class cOidcProvider is a cWebComponent
    
    Procedure Construct_Object
        Property Boolean pbLogging              True
        Property Handle phoOidcHandler          0 // Handle to the handler
        Property Handle phoOidcKeyStore         0 // Handle to the key store
        Property Handle phoClaimResolver        0 // Resolves claims for requested scopes
        Property Handle phoJWT                  0 // Handle to the JWT object
        
        { DesignTime=True }
        { EnumList="C_JWT_ALG_HS_256 C_JWT_ALG_HS_384 C_JWT_ALG_HS_512 C_JWT_ALG_RS_256 C_JWT_ALG_RS_384 C_JWT_ALG_RS_512 C_JWT_ALG_PS_256 C_JWT_ALG_PS_384 C_JWT_ALG_PS_512 C_JWT_ALG_ES_256 C_JWT_ALG_ES_384 C_JWT_ALG_ES_512" }
        Property Integer peSigningAlgorithm C_JWT_ALG_HS_512
        
        { Visibility=Private }
        Property Integer[] piaIgnoredErrors
        
        Object oJWT is a cOidcJWT
        End_Object
    End_Procedure
    
    Procedure End_Construct_Object
        Handle hoOidcKeyStore
        Integer iAlgo
        
        Forward Send End_Construct_Object
        
        Get phoOidcKeyStore to hoOidcKeyStore
        Set phoOidcKeyStore of oJWT to hoOidcKeyStore
        Set phoOidcProvider of oJWT to Self
        
        Get peSigningAlgorithm to iAlgo
        Set peAlgorithm of oJWT to iAlgo
        
        Send LoadKeys of oJWT
        Set phoJWT to oJWT
    End_Procedure
    
