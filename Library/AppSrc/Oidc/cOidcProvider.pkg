    // Called to validate the JWT signature and decode it, has a default implementation that can be overridden.
    { MethodType=Event }
    Procedure OnValidateToken String sJwt Boolean ByRef bOk tOidcJsonWebToken ByRef tOptToken
        Integer iRetVal iIndex iIndexTo iSearchIndex
        String sBaseUrl sIssuer sUsername
        String[] asBlacklistMembers
        Boolean bFound
        tOidcUserInfo tUserInfo
        tNameValuePair tSearch
        
        Get DecodeString of oJWT sJwt to iRetVal
        
        // Decode string checks for expiration aswell
        If (iRetVal) Begin
            Send LogErrorEvent 999 (SFormat("DecodeString gave return value '%1'", iRetVal))
            Move False to bOk
            Procedure_Return
        End
        
        // Issuer should be ourself (By default this is the BaseUrl)
        Send OnGetApplicationBaseUrl (&sBaseUrl)
        Send OidcEnsureTrailingSlash (&sBaseUrl)
        Get Issuer of oJWT to sIssuer
        If (sIssuer <> sBaseUrl) Begin
            Send LogErrorEvent 999 (SFormat("sIssuer <> sBaseUrl (%1 <> %2)", sIssuer, sBaseUrl))
            Move False to bOk
            Procedure_Return
        End
        
        Move True to bOk
        
        If (num_arguments > 2) Begin
            Move sIssuer to tOptToken.sIssuer
        
            // Get the JTI
            Get JWTID of oJWT to tOptToken.sJTI
            
            // Get the scopes
            Get CustomClaim of oJWT C_OIDC_CLAIM_SCOPE to tOptToken.sScope
            
            // Get the clientId
            Get CustomClaim of oJWT C_OIDC_CLAIM_CLIENT_ID to tOptToken.sClientId
            If (SizeOfString(tOptToken.sClientId) = 0) Begin
                Get CustomClaim of oJWT C_OIDC_CLAIM_AZP to tOptToken.sClientId
            End
            
            // Get the sub to sUserId
            Get Subject of oJWT to tOptToken.sSubject
            
            Send OnGetUserInfo tOptToken.sSubject (&tUserInfo)
            
            Send OnGetSubjectName tUserInfo (&sUsername)
            Move sUsername to tOptToken.sUsername
            
            Get Expiration  of oJWT to tOptToken.ubiExp
            Get IssuedAt    of oJWT to tOptToken.ubiIat
            Get NotBefore   of oJWT to tOptToken.ubiNbf            
            Get Audience    of oJWT to tOptToken.sAudience
            
            Move (StrSplitToArray("exp,iat,iss,jti,nbf,sub", ',')) to asBlacklistMembers
            Move (MemberCount(oJwt) -1) to iIndexTo
            
            //Iterate over all the members and add them to the claims, if they didn't serve their purpose already.
            For iIndex from 0 to iIndexTo
                Get MemberNameByIndex of oJWT iIndex to tSearch.sName
                If (BinarySearchArray(tSearch.sName, asBlacklistMembers) = -1) Begin // Not in blacklist
                    If (BinarySearchArray(tSearch, tOptToken.atCustomClaims) = -1) Begin // Not in customclaims yet, basically used for making the list binary sorted
                        Move (BinarySearchInsertPos()) to iSearchIndex
                        Get MemberValue of oJWT tSearch.sName to tSearch.sValue
                        Move (InsertInArray(tOptToken.atCustomClaims, iSearchIndex, tSearch)) to tOptToken.atCustomClaims
                    End
                End
            Loop
        End
    End_Procedure
    
