    // Returns a map of token types and their associated claims
    { MethodType=Event }
    Procedure OnGetTokenToClaimsMap tOidcTokenClaimMap[] ByRef atMap String[] asOptRequestedScopes
        tOidcTokenClaimMap tMap tEmpty
        Integer iIndex iIndexTo
        tOidcScopeClaimsMap[] atScopeClaimsMap

        // ----- 1. ID TOKEN MAP (Dynamic) -----
        Move C_OIDC_TOKEN_ID_TOKEN to tMap.iTokenType
        Move C_OIDC_CLAIM_ISSUER      to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_SUBJECT     to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_AUDIENCE    to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_EXPIRY      to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_ISSUED_AT   to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_NONCE       to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_AUTH_TIME   to tMap.asClaims[-1]
        
        If (num_arguments > 1) Begin
            Send OnGetScopeToClaimsMap (&atScopeClaimsMap)
        
            Move (SizeOfArray(asOptRequestedScopes) - 1) to iIndexTo        
            For iIndex from 0 to iIndexTo
                Send OnGetClaimsForScope atScopeClaimsMap asOptRequestedScopes[iIndex] (&tMap.asClaims)
            Loop
        End
        
        Move tMap to atMap[-1]
        Move tEmpty to tMap
    
        // ----- 2. ACCESS TOKEN MAP (RFC 9068 / FAPI) -----
        Move C_OIDC_TOKEN_ACCESS_TOKEN to tMap.iTokenType
        Move C_OIDC_CLAIM_ISSUER       to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_SUBJECT      to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_AUDIENCE     to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_EXPIRY       to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_ISSUED_AT    to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_CLIENT_ID    to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_SCOPE        to tMap.asClaims[-1]
        
        Move tMap to atMap[-1]
        Move tEmpty to tMap
    
        // ----- 3. REFRESH TOKEN MAP -----
        Move C_OIDC_TOKEN_REFRESH_TOKEN to tMap.iTokenType
        Move C_OIDC_CLAIM_ISSUER        to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_SUBJECT       to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_AUDIENCE      to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_EXPIRY        to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_ISSUED_AT     to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_CLIENT_ID     to tMap.asClaims[-1]
        Move C_OIDC_CLAIM_SCOPE         to tMap.asClaims[-1]
    
        Move tMap to atMap[-1]
    End_Procedure
    
    // Returns the base url of the application to create the necessary redirect urls
    // NOTE: Shouldn't end on a slash but on the TLD
    { MethodType=Event }
    Procedure OnGetApplicationBaseUrl String ByRef sBaseUrl
        // Empty stub
    End_Procedure

    { MethodType=Event }
    Procedure OnGetAuthorizeUrl String ByRef sAuthUrl
        String sBaseUrl sHandlerPath

        // Base
        Send OnGetApplicationBaseUrl (&sBaseUrl)
        Send OidcEnsureTrailingSlash (&sBaseUrl)

        // Handler path
        Get psPath of (phoOidcHandler(Self)) to sHandlerPath
        Send OidcEnsureTrailingSlash (&sHandlerPath)

        // Concatenate it all + AUTHORIZE_ENDPOINT
        Move (sBaseUrl + sHandlerPath + C_OIDC_ENDPOINT_AUTHORIZE) to sAuthUrl
    End_Procedure

    Function NormalizeAuthorizeContinueUrl String sContinue String sPromptToRemove Boolean ByRef bOk Returns String
        String sAuthorizeUrl
        Integer iAuthPos

        Move False to bOk
        Send OnGetAuthorizeUrl (&sAuthorizeUrl)
        Move (Pos(Lowercase(sAuthorizeUrl), Lowercase(sContinue))) to iAuthPos
        If (iAuthPos <> 1) Begin
            Function_Return ""
        End

        // Recreate the URL with the expected casing; mismatched casing can affect cookies.
        Move (sAuthorizeUrl + Right(sContinue, SizeOfString(sContinue) - SizeOfString(sAuthorizeUrl))) to sContinue

        If (SizeOfString(sPromptToRemove) > 0) Begin
            Get OidcUrlWithoutPrompt sContinue sPromptToRemove to sContinue
        End

        Move True to bOk
        Function_Return sContinue
    End_Function

    Function CreateErrorRedirectUri String sRedirectUri String sError String sDescription String sState String sResponseMode String sOptErrorURI Returns String
        String sErrorURI sMarker

        If (num_arguments > 5) Begin
            Move sOptErrorURI to sErrorURI
        End

        Get UrlEncode sRedirectUri False to sRedirectUri

        // Use query response mode by default
        Move "?" to sMarker
        If (sResponseMode = C_OIDC_RESPONSE_MODE_FRAGMENT) Begin
            Move "#" to sMarker
        End

        Send OidcAddUrlParam (&sRedirectUri) C_OIDC_PARAM_ERROR sError sMarker
        Send OidcAddUrlParam (&sRedirectUri) C_OIDC_PARAM_ERROR_DESCRIPTION sDescription sMarker
        If (SizeOfString(sErrorURI) > 0) Begin
            Send OidcAddUrlParam (&sRedirectUri) C_OIDC_PARAM_ERROR_URI sErrorURI sMarker
        End

        // Did we have a state?
        If (SizeOfString(sState) > 0) Begin
            Send OidcAddUrlParam (&sRedirectUri) C_OIDC_PARAM_STATE sState sMarker
        End

        Function_Return sRedirectUri
    End_Function

