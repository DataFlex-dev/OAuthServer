    // Helper procedure to generate a subject name shown in the consent view
    { MethodType=Event }
    Procedure OnGetSubjectName tOidcUserInfo tUserInfo String ByRef sName
        String sFirst sLast sFullName sUsername
        
        Move tUserInfo.sFullName            to sFullName
        Move tUserInfo.sGivenName           to sFirst
        Move tUserInfo.sFamilyName          to sLast
        Move tUserInfo.sPreferredUsername   to sUsername
        
        If (SizeOfString(sFullName) > 0) Begin
            Move sFullName to sName
        End
        Else If (SizeOfString(sFirst) > 0 and SizeOfString(sLast) > 0) Begin
            Move (sFirst * sLast) to sName
        End
        Else If (SizeOfString(sUsername) > 0) Begin
            Move sUsername to sName
        End
    End_Procedure
    
    // Helper function to determine the claim's json type
    { MethodType=Event }
    Procedure OnGetClaimJsonType String sClaim Integer ByRef iJsonType
        Integer iType
        
        Case Begin
            Case (sClaim = C_OIDC_CLAIM_AUTH_TIME)
            Case (sClaim = C_OIDC_CLAIM_EXPIRY)
            Case (sClaim = C_OIDC_CLAIM_ISSUED_AT)
                Move jsonTypeInteger to iType
                Case Break
            Case (sClaim = C_OIDC_CLAIM_EMAIL_VERIFIED)
                Move jsonTypeBoolean to iType
                Case Break
            Case Else
                Move jsonTypeString to iType
        Case End
        
        Move iType to iJsonType
    End_Procedure
    
