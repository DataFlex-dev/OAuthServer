    { Visibility=Private }
    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrText
        Boolean bIsIgnored
        
        // Ignore expected errors
        Get IsIgnoredError iErrNum to bIsIgnored
        If (bIsIgnored) ;
            Procedure_Return
        
       // ToDo: do some logging here
       // Default error handling
        Send Error_Report of ghoErrorHandler iErrNum iErrLine sErrText 
    End_Procedure
End_Class
