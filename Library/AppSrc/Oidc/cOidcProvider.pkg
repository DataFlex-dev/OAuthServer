    // Event that resolves the claims for a request, should fall back on data gotten from the OnGetUserInfo
    // This probably shouldn't be overridden
    { MethodType=Event }
    Procedure OnResolveScopesToClaims String sUserId String sClientId String[] asScopes tNameValuePair[] ByRef atClaims
        Integer  iIndex iIndexTo iSearchIndex
        String[] asAllClaims asSystemClaims
        String   sAudience sClaim
        Boolean  bInclude bIsSystemScope bRequested
        Handle   hoResolver
        tOidcScopeClaimsMap[]   atScopeClaimsMap
        tOidcUserInfo           tUserInfo
        tOidcClient             tClient
        tOidcScopeClaimsMap     tScopeClaimMap
        tNameValuePair          tPair
    
        Send OnGetScopeToClaimsMap (&atScopeClaimsMap)
    
        Move (SizeOfArray(atScopeClaimsMap) - 1) to iIndexTo

        Get OidcDedupeStringArray asScopes to asScopes
    
        For iIndex from 0 to iIndexTo
            Move False to bInclude
    
            // Include if system scope
            Move atScopeClaimsMap[iIndex].bIsSystemScope to bIsSystemScope
            
            If (bIsSystemScope) Begin
                Move True to bInclude
                Move (AppendArray(asSystemClaims, atScopeClaimsMap[iIndex].asAllowedClaims)) to asSystemClaims
            End
            
            // Check for explicitly requested scopes
            Move (SearchArray(atScopeClaimsMap[iIndex].sScope, asScopes)) to iSearchIndex
            If (iSearchIndex <> -1) Begin
                Move True to bRequested // Explicitly requested
                Move True to bInclude                    
            End
    
            If (bInclude) Begin
                // Append claims
                Move (AppendArray(asAllClaims, atScopeClaimsMap[iIndex].asAllowedClaims)) to asAllClaims
    
                // Append audience ONLY for requested scopes (skipping system scopes)
                If (bRequested) Begin
                    Move (sAudience * Trim(atScopeClaimsMap[iIndex].sAudience)) to sAudience
                End
            End
        Loop
    
        // Dedupe final arrays
        Get OidcDedupeStringArray asAllClaims    to asAllClaims
        Get OidcDedupeStringArray asSystemClaims to asSystemClaims
        Move (Trim(sAudience)) to sAudience
        
        Get phoClaimResolver to hoResolver
        Send OnGetUserInfo sUserId (&tUserInfo)
        Send OnGetClientInfo sClientId (&tClient)
        
        Move (SizeOfArray(asAllClaims) - 1) to iIndexTo
        // Resolve each claim and create tNameValuePair in the resulting tNameValuePair[]
        For iIndex from 0 to iIndexTo
            Move asAllClaims[iIndex] to sClaim
            
            Move (SearchArray(sClaim, asSystemClaims) <> -1) to bIsSystemScope
            
            // Initialize the claim pair
            Move sClaim to tPair.sName
            Move ""     to tPair.sValue
            
            // Call resolver if it's set
            If (hoResolver <> 0) Begin
                Send OnResolveClaim of hoResolver tUserInfo tClient sClaim bIsSystemScope asScopes (&tPair.sValue)
            End
            
            // Optionally we fill a default value for system claims if they are stil empty
            If (bIsSystemScope and tPair.sValue = "") Begin
                Get ResolveSystemClaim sClaim tClient tUserInfo to tPair.sValue
            End
            
            If (sClaim = C_OIDC_CLAIM_AUDIENCE) Begin
                If (tPair.sValue = "") Begin
                    Move sAudience to tPair.sValue
                End
            End
            
            // Add client_id if not yet set by the ClaimResolver
            If (sClaim = C_OIDC_CLAIM_CLIENT_ID and tPair.sValue = "") Begin
                Move tClient.sClientId to tPair.sValue
            End
            
            // append to the result
            Move tPair to atClaims[-1]
        Loop
    End_Procedure
    
