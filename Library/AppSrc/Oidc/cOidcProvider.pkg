    Function GenerateTokensClientCredentials tOidcClient tClient String[] asScopes String ByRef sAccessToken UBigInt ByRef ubiExpiresAt Returns Integer
        tNameValuePair[] atClaims atAccessTokenClaims
        UBigInt ubiIat
        Boolean bOk
        String sScopes sSystemAudience sJti
        
        // Check client type
        If (tClient.sClientType = C_OIDC_CLIENT_TYPE_PUBLIC) Begin
            Function_Return C_OIDC_GENERATE_TOKENS_UNAUTHORIZED_CLIENT
        End
        
        // Validate requested scopes
        Get OidcValidateStringArray asScopes tClient.asAllowedScopes to bOk
        If (not(bOk)) Begin
            Function_Return C_OIDC_GENERATE_TOKENS_INVALID_SCOPE
        End
        
        Get CurrentUnixTime to ubiIat
        Move (ubiIat + tClient.iAccessTokenLifetime) to ubiExpiresAt
        
        // Resolve claims for access token
        Send OnResolveScopesToClaims "" tClient.sClientId asScopes (&atClaims)
        
        // Filter to only contain default access token claims
        Get FilterClaimsForToken C_OIDC_TOKEN_ACCESS_TOKEN True asScopes atClaims to atAccessTokenClaims
        
        // Add scopes as claim
        Move (StrJoinFromArray(asScopes, C_OIDC_CHARACTER_SPACE)) to sScopes
        Get AddTokenClaim C_OIDC_CLAIM_SCOPE sScopes atAccessTokenClaims to atAccessTokenClaims
        
        Get AddTokenClaim C_OIDC_CLAIM_EXPIRY ubiExpiresAt atAccessTokenClaims to atAccessTokenClaims
        Get AddTokenClaim C_OIDC_CLAIM_JTI (RandomHexUUID()) atAccessTokenClaims to atAccessTokenClaims
        
        // Set azp (authorized party) to client_id
        Get AddTokenClaim C_OIDC_CLAIM_AZP tClient.sClientId atAccessTokenClaims to atAccessTokenClaims
        
        Get GenerateToken of oJWT atAccessTokenClaims to sAccessToken
        
        Function_Return C_OIDC_GENERATE_TOKENS_SUCCESS
    End_Function
    
    Function GenerateTokensAuthCode tOidcAuthorizationCodeInfo tCode String ByRef sIdToken String ByRef sAccessToken String ByRef sRefreshToken UBigInt ByRef ubiExpiresAt String sOptRequestedScopes Returns Integer
        String[] asReqScopes asAllowedScopes asFinalScopes
        Integer iRetVal iIndex iSearch
        
        // The upper limit is what has been consented to and agreed to
        Move (StrSplitToArray(tCode.sScope, C_OIDC_CHARACTER_SPACE)) to asAllowedScopes
        
        If (num_arguments > 5 and SizeOfString(sOptRequestedScopes) > 0) Begin
            Move (StrSplitToArray(sOptRequestedScopes, C_OIDC_CHARACTER_SPACE)) to asReqScopes
            
            // Forgiving logic: only keep wat is in allowed scopes
            Get OidcIntersectStringArray asReqScopes asAllowedScopes to asFinalScopes 
        End
        Else Begin
            Move (StrSplitToArray(tCode.sScope, C_OIDC_CHARACTER_SPACE)) to asFinalScopes
        End
 
        Send OnConsumeAuthCode tCode.sAuthCode    
        
        Get GenerateTokens tCode.sUserId tCode.sClientId asFinalScopes (&sIdToken) (&sAccessToken) (&sRefreshToken) (&ubiExpiresAt) "" tCode.sNonce to iRetVal
        Function_Return iRetVal
    End_Function
    
    Function GenerateTokensRefreshCode tOidcRefreshToken tRefreshToken String[] asScopes String ByRef sIdToken String ByRef sAccessToken String ByRef sRefreshToken UBigInt ByRef ubiExpiresAt tOidcExpiries tOptExpiries tOidcCustomClaims tOptCustomClaims Returns Integer
        Integer iRetVal

        If (num_arguments > 7) Begin
            // Expiries + custom claims included
            Get GenerateTokens tRefreshToken.sUserId tRefreshToken.sClientId asScopes   ;
                               (&sIdToken) (&sAccessToken) (&sRefreshToken)             ;
                               (&ubiExpiresAt) "" tRefreshToken.sFamilyId tOptExpiries tOptCustomClaims to iRetVal
        End
        Else If (num_arguments > 6) Begin
            // Expiries included
            Get GenerateTokens tRefreshToken.sUserId tRefreshToken.sClientId asScopes   ;
                               (&sIdToken) (&sAccessToken) (&sRefreshToken)             ;
                               (&ubiExpiresAt) "" tRefreshToken.sFamilyId tOptExpiries  to iRetVal
        End
        Else Begin
            Get GenerateTokens tRefreshToken.sUserId tRefreshToken.sClientId asScopes   ;
                               (&sIdToken) (&sAccessToken) (&sRefreshToken)             ;
                               (&ubiExpiresAt) "" tRefreshToken.sFamilyId               to iRetVal
        End

        Function_Return iRetVal
    End_Function

    { Visibility=Private }
    Function GenerateTokens String sUserId String sClientId String[] asScopes String ByRef sIdToken String ByRef sAccessToken String ByRef sRefreshToken UBigInt ByRef ubiExpiresAt String sOptFamilyId String sOptNonce tOidcExpiries tOptExpiries tOidcCustomClaims tOptCustomClaims Returns Integer
        String sFamilyId sNonce sScopes sSystemAudience sJti sAccessJti
        tNameValuePair[] atClaims atIdTokenClaims atAccessTokenClaims atRefreshTokenClaims
        tNameValuePair tNvpSearch
        Integer iIndex iIndexTo
        UBigInt ubiUnixTime ubiIat ubiRefreshExpiry
        Boolean bGenerateAccessToken bGenerateIdToken bGenerateRefreshToken bExpiryOverride
        tOidcClient tClient
        tOidcRefreshToken tRefreshToken
        tOidcCustomClaims tCustomClaims

        If (num_arguments > 7) Begin
            Move sOptFamilyId to sFamilyId
        End

        If (num_arguments > 8) Begin
            Move sOptNonce to sNonce
        End

        If (num_arguments > 9) Begin
            Move True to bExpiryOverride
        End

        If (num_arguments > 10) Begin
            Move tOptCustomClaims to tCustomClaims
        End

        // Resolve the claims with the requested scopes that have been validated
        Send OnResolveScopesToClaims sUserId sClientId asScopes (&atClaims)
        
        // Get the issued at claim
        Move C_OIDC_CLAIM_ISSUED_AT to tNvpSearch.sName
        Move (SearchArray(tNvpSearch, atClaims)) to iIndex
        If (iIndex = -1) Begin
            // Invalid claims
            Function_Return C_OIDC_GENERATE_TOKENS_SERVER_ERROR
        End
        Move atClaims[iIndex].sValue to ubiIat
           
        // Generate tokens (ID token only if scope contains "openid", refresh token only if scope contains "offline_access")
        Move (SearchArray(C_OIDC_SCOPE_OPENID,         asScopes) >= 0) to bGenerateIdToken
        Move (SearchArray(C_OIDC_SCOPE_OFFLINE_ACCESS, asScopes) >= 0) to bGenerateRefreshToken
        
        Send OnGetClientInfo sClientId (&tClient)
        
        Move True to bGenerateAccessToken // Change this to be dynamic if we decide to support the implicit flow later on
        
        // id_token (optional)
        If (bGenerateIdToken) Begin
            // Get id token claims
            Get FilterClaimsForToken C_OIDC_TOKEN_ID_TOKEN bGenerateAccessToken asScopes atClaims to atIdTokenClaims
            
            // Inject system claims
            If (bExpiryOverride and tOptExpiries.iIDTokenLifetime <> 0) Begin
                Get AddTokenClaim C_OIDC_CLAIM_EXPIRY (ubiIat + tOptExpiries.iIDTokenLifetime) atIdTokenClaims to atIdTokenClaims
            End
            Else Begin
                Get AddTokenClaim C_OIDC_CLAIM_EXPIRY (ubiIat + tClient.iIDTokenLifetime) atIdTokenClaims to atIdTokenClaims    
            End
            
            // Override audience for id token to be the client id
            Get AddTokenClaim C_OIDC_CLAIM_AUDIENCE tClient.sClientId atIdTokenClaims to atIdTokenClaims
            
            // Override JTI with new generated one (must be unique for each token)
            Get AddTokenClaim C_OIDC_CLAIM_JTI (RandomHexUUID()) atIdTokenClaims to atIdTokenClaims
           
            If (SizeOfString(sNonce) > 0) Begin
                Get AddTokenClaim C_OIDC_CLAIM_NONCE sNonce atIdTokenClaims to atIdTokenClaims
            End
            
            Move (SizeOfArray(tCustomClaims.atIdClaims) - 1) to iIndexTo
            For iIndex from 0 to iIndexTo
                Get AddTokenClaim tCustomClaims.atIdClaims[iIndex].sName tCustomClaims.atIdClaims[iIndex].sValue atIdTokenClaims to atIdTokenClaims
            Loop

            Get GenerateToken of oJWT atIdTokenClaims to sIdToken
        End
        
        // acccess_token
        If (bGenerateAccessToken) Begin
            Get FilterClaimsForToken C_OIDC_TOKEN_ACCESS_TOKEN bGenerateAccessToken asScopes atClaims to atAccessTokenClaims
            // Inject system claims
            If (bExpiryOverride and tOptExpiries.iAccessTokenLifetime <> 0) Begin
                Move (ubiIat + tOptExpiries.iAccessTokenLifetime) to ubiExpiresAt
            End
            Else Begin
                Move (ubiIat + tClient.iAccessTokenLifetime) to ubiExpiresAt
            End
            Get AddTokenClaim C_OIDC_CLAIM_EXPIRY ubiExpiresAt atAccessTokenClaims to atAccessTokenClaims
             
            // scopes (space separated)
            Move (StrJoinFromArray(asScopes, C_OIDC_CHARACTER_SPACE)) to sScopes
            Get AddTokenClaim C_OIDC_CLAIM_SCOPE sScopes atAccessTokenClaims to atAccessTokenClaims
            
            // client_id (azp = authorized party)
            Get AddTokenClaim C_OIDC_CLAIM_AZP tClient.sClientId atAccessTokenClaims to atAccessTokenClaims
            
            // Override JTI with new generated one (must be unique for each token)
            Move (RandomHexUUID()) to sAccessJti
            Get AddTokenClaim C_OIDC_CLAIM_JTI sAccessJti atAccessTokenClaims to atAccessTokenClaims
            
            Move (SizeOfArray(tCustomClaims.atAccessClaims) - 1) to iIndexTo
            For iIndex from 0 to iIndexTo
                Get AddTokenClaim tCustomClaims.atAccessClaims[iIndex].sName tCustomClaims.atAccessClaims[iIndex].sValue atAccessTokenClaims to atAccessTokenClaims
            Loop
            
            Get GenerateToken of oJWT atAccessTokenClaims to sAccessToken
        End
        
        // refresh_token (optional)
        If (bGenerateRefreshToken) Begin
            Get FilterClaimsForToken C_OIDC_TOKEN_REFRESH_TOKEN bGenerateAccessToken asScopes atClaims to atRefreshTokenClaims
            // Inject system claims
            If (bExpiryOverride and tOptExpiries.iIDTokenLifetime <> 0) Begin
                Move (ubiIat + tOptExpiries.iRefreshTokenLifetime) to ubiRefreshExpiry
            End
            Else Begin
                Move (ubiIat + tClient.iRefreshTokenLifetime) to ubiRefreshExpiry
            End
            Get AddTokenClaim C_OIDC_CLAIM_EXPIRY ubiRefreshExpiry atRefreshTokenClaims to atRefreshTokenClaims
            
            // scopes
            Get AddTokenClaim C_OIDC_CLAIM_SCOPE sScopes atRefreshTokenClaims to atRefreshTokenClaims
            
            // Set audience to ourself (By default we use the base URL)
            Send OnGetSystemAudience (&sSystemAudience)
            Get AddTokenClaim C_OIDC_CLAIM_AUDIENCE sSystemAudience atRefreshTokenClaims to atRefreshTokenClaims
            
            // Override JTI with new generated one (must be unique for each token)
            Get RandomHexUUID to sJti
            Get AddTokenClaim C_OIDC_CLAIM_JTI sJti atRefreshTokenClaims to atRefreshTokenClaims
            
            // Generate random hex UUID if we don't have one yet
            If (SizeOfString(sFamilyId) = 0) Begin
                Get RandomHexUUID to sFamilyId
            End
            
            Move (SizeOfArray(tCustomClaims.atRefreshClaims) - 1) to iIndexTo
            For iIndex from 0 to iIndexTo
                Get AddTokenClaim tCustomClaims.atRefreshClaims[iIndex].sName tCustomClaims.atRefreshClaims[iIndex].sValue atRefreshTokenClaims to atRefreshTokenClaims
            Loop
            
            // Save to DB
            Move sJti               to tRefreshToken.sJTI
            Move sClientId          to tRefreshToken.sClientId
            Move sUserId            to tRefreshToken.sUserId
            Move ubiIat             to tRefreshToken.ubiIat
            Move ubiRefreshExpiry   to tRefreshToken.ubiExp
            Move 0                  to tRefreshToken.bRevoked
            Move 0                  to tRefreshToken.bUsed
            Move sFamilyId          to tRefreshToken.sFamilyId
            Move sAccessJti         to tRefreshToken.sAccessJti
            Send OnCreateRefreshToken tRefreshToken
            
            Get GenerateToken of oJWT atRefreshTokenClaims to sRefreshToken
        End   
        
        Function_Return C_OIDC_GENERATE_TOKENS_SUCCESS
    End_Function
    
    // Helper functions to get the index/value of custom claims
    Function CustomClaimIndex String sClaim tNameValuePair[] atCustomClaims Returns Integer
        tNameValuePair tSearch
        Move sClaim to tSearch.sName
        Function_Return (SearchArray(tSearch, atCustomClaims))
    End_Function
    
    Function CustomClaimValue String sClaim tNameValuePair[] atCustomClaims Returns String
        Integer iIndex
        String sResult
        Get CustomClaimIndex sClaim atCustomClaims to iIndex
        If (iIndex <> -1) Begin
            Move atCustomClaims[iIndex].sValue to sResult
        End
        Function_Return sResult
    End_Function
    
    Procedure ProgramError String sErr
        Error DFERR_PROGRAM sErr
    End_Procedure
    
    Procedure OperatorError String sErr
        Error DFERR_OPERATOR sErr
    End_Procedure

    Procedure MissingHandleError String sHandles String sMsgName 
        String[] asHandles
        Integer iIndex iSize
        
        Move (StrSplitToArray(sHandles, C_OIDC_CHARACTER_SPACE)) to asHandles
        Move "" to sHandles
        Move (SizeOfArray(asHandles)) to iSize
        
        For iIndex from 0 to (iSize - 1)
            Move (sHandles * asHandles[iIndex]) to sHandles
            // Add comma for everyting but the last item
            If (iIndex < iSize - 1) ;
                Move (sHandles + ",") to sHandles
            Else ;
                Move (sHandles * "&") to sHandles
        Loop

        Error DFERR_PROGRAM (SFormat("Invalid value(s) for handle(s) %1 in %2 of a cOidcProvider implementation.", sHandles, sMsgName))
    End_Procedure

    Procedure ValidationError Handle hHandle String sMsgName
        String sTable

        Get SQLStrFileName of hHandle to sTable
        Error DFERR_PROGRAM (SFormat("Error during Request_Validate on table %1 in %2 of a cOidcProvider implementation.", sTable, sMsgName))
    End_Procedure

    Procedure SaveError Handle hHandle String sMsgName
        String sTable
         
        Get SQLStrFileName of hHandle to sTable
        Error DFERR_PROGRAM (SFormat("Error during Request_Save on table %1 in %2 of a cOidcProvider implementation.", sTable, sMsgName))
    End_Procedure

    // ToDo: Should the message names become constants?

    Procedure SaveData Handle hoDD String sMsgName
        Boolean iRetVal
        
        Get Request_Validate of hoDD to iRetVal
        If (iRetVal) Begin
            Send ValidationError hoDD sMsgName
            Procedure_Return
        End
        
        Move False to Err
        Send Request_Save of hoDD
        If (Err) Begin
            Send SaveError hoDD sMsgName
        End
    End_Procedure

    // Helper function to validate redirect uri's
    { Visibility=Private }
    Function ValidateRedirectUri tOidcClient tClient String sRedirectUri Returns Boolean
        Integer iIndex iItemCount
        Boolean bRetVal
        
        Move (SizeOfArray(tClient.asRedirectURIs)) to iItemCount
        
        For iIndex from 0 to (iItemCount - 1)
            // If localhost/127.0.0.1 remove the port (we ignore the port)
            Get OidcRemoveLocalPort sRedirectUri to sRedirectUri
            
            // Exact match?
            If (tClient.asRedirectURIs[iIndex] = sRedirectUri) Begin
                Move True to bRetVal
                Move iItemCount to iIndex
            End
        Loop
        
        Function_Return bRetVal
    End_Function

    // Helper procedure to populate the ScopeClaimsMap by passing a scope and a claims string that is space-separated
    // bOptIsSystemScope is used for default claim resolving which can be overridden by the developer
    { Visibility=Private }
    Procedure AddScopeClaimsMap tOidcScopeClaimsMap[] ByRef tScopeClaimsMap String sScope String sClaims Boolean bOptIsSystemScope Boolean bOptAudience
        Integer iScopeIndex iIndex iClaimIndex
        tOidcScopeClaimsMap tSearch
        String sSearch sClaim sAudience
        String[] asClaims
        
        Move sScope to tSearch.sScope
        
        If (num_arguments > 3) ;
            Move bOptIsSystemScope to tSearch.bIsSystemScope
        
        If (num_arguments > 4) ;
            Move bOptAudience to tSearch.sAudience
        
        Move (SearchArray(tSearch, tScopeClaimsMap)) to iScopeIndex
        If (iScopeIndex = -1) Begin
            Move (SizeOfArray(tScopeClaimsMap)) to iScopeIndex
            Move tSearch to tScopeClaimsMap[iScopeIndex]
        End
        
        Move (StrSplitToArray(sClaims, C_OIDC_CHARACTER_SPACE)) to asClaims
        
        For iIndex from 0 to (SizeOfArray(asClaims) - 1)
            Move asClaims[iIndex] to sClaim
            Move (SearchArray(sClaim, tScopeClaimsMap[iScopeIndex].asAllowedClaims)) to iClaimIndex
            If (iClaimIndex = -1) Begin
                // Add the claim if it doesn't exist yet
                Move (SizeOfArray(tScopeClaimsMap[iScopeIndex].asAllowedClaims)) to iClaimIndex
                Move sClaim to tScopeClaimsMap[iScopeIndex].asAllowedClaims[iClaimIndex]
            End
        Loop
    End_Procedure

    // Helper function to resolve system claims
    { Visibility=Private }
    Function ResolveSystemClaim String sClaim tOidcClient tClient tOidcUserInfo tUserInfo Returns String
        String sResult sIssuer

        Case Begin
            Case (sClaim = C_OIDC_CLAIM_AUDIENCE)
                Move tClient.sClientId to sResult
                Case Break
            Case (sClaim = C_OIDC_CLAIM_AUTH_TIME)
                If (not(IsNullDateTime(tUserInfo.dtLastLogin))) Begin
                    Get DateTimeToUnixTime (Oidc_ConvertDateTimeToUtc(Self, tUserInfo.dtLastLogin)) to sResult
                End
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_EMAIL)
                Move tUserInfo.sEmail to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_EMAIL_VERIFIED)
                If (tUserInfo.bEmailVerified) ;
                    Move "true" to sResult
                Else ;
                    Move "false" to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_FAMILY_NAME)
                Move tUserInfo.sFamilyName to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_GIVEN_NAME)
                Move tUserInfo.sGivenName to sResult
                Case Break  
                
            Case (sClaim = C_OIDC_CLAIM_MIDDLE_NAME)
                Move tUserInfo.sMiddleName to sResult
                Case Break                      
            
            Case (sClaim = C_OIDC_CLAIM_ISSUED_AT)
                Get CurrentUnixTime to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_ISSUER)
                Send OnGetApplicationBaseUrl (&sIssuer)
                Send OidcEnsureTrailingSlash (&sIssuer)
                Move sIssuer to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_NAME)
                Move tUserInfo.sFullName to sResult
                Case Break                        
            
            Case (sClaim = C_OIDC_CLAIM_NICKNAME)
            Case (sClaim = C_OIDC_CLAIM_PREF_USERNAME)
                Move tUserInfo.sPreferredUsername to sResult
                Case Break
            
            Case (sClaim = C_OIDC_CLAIM_PICTURE)
                Move tUserInfo.sPicture to sResult
                Case Break
            
            Case (sClaim = C_OIDC_CLAIM_PROFILE)
                Move tUserInfo.sProfile to sResult
                Case Break
            
            Case (sClaim = C_OIDC_CLAIM_SUBJECT)
                Move tUserInfo.sSubject to sResult
                Case Break
            
            Case (sClaim = C_OIDC_CLAIM_UPDATED_AT)
                If (not(IsNullDateTime(tUserInfo.dtLastUpdate))) Begin
                    Get DateTimeToUnixTime tUserInfo.dtLastUpdate to sResult
                End
                Case Break
                
            Case Else
                // Else we do nothing, keep it null/empty
        Case End
        
        Function_Return sResult
    End_Function

    // Helper function to validate given consent
    { Visibility=Private }
    Function ValidateConsent tOidcClient tClient String[] asRequestedScopes Returns Boolean
        String sUserId
        String[] asAllowedScopes
        Boolean bOk

        Send OnGetUserId (&sUserId)
        Send OnGetConsentedScopesByClientId sUserId tClient.sClientId (&asAllowedScopes)
        
        Get OidcValidateStringArray asRequestedScopes asAllowedScopes to bOk
        
        Function_Return bOk
    End_Function
    
    // Helper function that maps scopes to individual claims
    { Visibility=Private }
    Procedure OnGetClaimsForScope tOidcScopeClaimsMap[] atMap String sScope String[] ByRef asClaims
        Integer iMapsEnd iMapIndex iClaimIndex iClaimEnd 
        String[] asScopeClaims
        
        Move (SizeOfArray(atMap) -1) to iMapsEnd
        
        For iMapIndex from 0 to iMapsEnd
            If (Lowercase(atMap[iMapIndex].sScope) = Lowercase(sScope)) Begin
                Move atMap[iMapIndex].asAllowedClaims to asScopeClaims
                Move (SizeOfArray(asScopeClaims) - 1) to iClaimEnd
                
                For iClaimIndex from 0 to iClaimEnd
                    // Use a helper to avoid duplicates (defined below)
                    Send AddUniqueClaim asScopeClaims[iClaimIndex] (&asClaims)
                Loop
                
                Move iMapsEnd to iMapIndex // Found it, stop looking
            End
        Loop
    End_Procedure
    
    // Helper function for adding unique claims
    { Visibility=Private }
    Procedure AddUniqueClaim String sClaim String[] ByRef asClaims
        Integer iSearch
        Move (SearchArray(sClaim, asClaims)) to iSearch
        If (iSearch = -1) Begin
            Move sClaim to asClaims[SizeOfArray(asClaims)]
        End
    End_Procedure

    // Helper function to search and change the value of a claim in a tNameValuePair[]
    { Visibility=Private }
    Function AddTokenClaim String sClaim String sValue tNameValuePair[] atClaims Returns tNameValuePair[]
        tNameValuePair tSearch
        Integer iIndex
        
        Move sClaim to tSearch.sName
        Move (SearchArray(tSearch, atClaims)) to iIndex
        If (iIndex = -1) Begin
            Move (SizeOfArray(atClaims)) to iIndex
            Move sClaim to atClaims[iIndex].sName
        End
        Move sValue to atClaims[iIndex].sValue
        
        Function_Return atClaims
    End_Function

    // Helper function to filter claims on token type
    { Visibility=Private }
    Function FilterClaimsForToken Integer iTokenType Boolean bAccessTokenAvailable String[] asRequestedScopes tNameValuePair[] atAllClaims Returns tNameValuePair[]
        tOidcTokenClaimMap[] atMaps
        tOidcTokenClaimMap   tMap
        tNameValuePair[]     atResult
        Integer iMaps iMapIndex iClaimIndex iSearch 
        String sClaim
        Boolean bIncludeRequestedScopeClaims
    
        // Scope-derived identity claims belong in the ID token only when there is no
        // access token available for the client to retrieve them through the UserInfo path.
        Move (iTokenType = C_OIDC_TOKEN_ID_TOKEN and not(bAccessTokenAvailable)) to bIncludeRequestedScopeClaims
        
        If (bIncludeRequestedScopeClaims) Begin
            Send OnGetTokenToClaimsMap (&atMaps) asRequestedScopes
        End
        Else Begin
            Send OnGetTokenToClaimsMap (&atMaps)
        End
        
        Move (SizeOfArray(atMaps)) to iMaps
    
        // find matching map
        For iMapIndex from 0 to (iMaps -1)
            If (atMaps[iMapIndex].iTokenType = iTokenType) Begin
                Move atMaps[iMapIndex] to tMap
                Move iMaps to iMapIndex // Leave the for loop
            End
        Loop
        
        // filter
        For iClaimIndex from 0 to (SizeOfArray(atAllClaims)-1)
            Move atAllClaims[iClaimIndex].sName to sClaim
            
            Move (SearchArray(sClaim, tMap.asClaims)) to iSearch
            If (iSearch <> -1) Begin
                Move atAllClaims[iClaimIndex] to atResult[-1]
            End
        Loop
    
        Function_Return atResult
    End_Function


    Procedure IgnoreError Integer iErrNum
        Integer[] iaIgnoredErrors
        Integer iIndex
        
        Get piaIgnoredErrors to iaIgnoredErrors
        
        Move (BinarySearchArray(iErrNum, iaIgnoredErrors)) to iIndex
        If (iIndex = -1) Begin
            Move (BinarySearchInsertPos()) to iIndex
            Move (InsertInArray(iaIgnoredErrors, iIndex, iErrNum)) to iaIgnoredErrors
        End
        
        Set piaIgnoredErrors to iaIgnoredErrors
    End_Procedure


    { Visibility=Private }
    Function IsIgnoredError Integer iErrNum Returns Boolean
        Integer[] iaIgnoredErrors
        Integer iIndex
        
        Get piaIgnoredErrors to iaIgnoredErrors
        
        Move (BinarySearchArray(iErrNum, iaIgnoredErrors)) to iIndex
        Function_Return (iIndex <> -1)
    End_Function
    

    
